# BMW AI Copilot backend configuration. Copy to `.env` (never committed) and adjust.
# Every variable is optional for a local run on a loopback HOST; the value shown is the default. Docker Compose
# needs OWNER_TOKEN and SESSION_SECRET set here (the containers listen on 0.0.0.0), and sets HOST, PORT and
# DATABASE_PATH itself (they win over this file inside the container).
# Never put a vehicle identification number, an e-mail address or other personal data in here.

# HTTP port the backend listens on.
PORT=3000
# Interface to bind; 127.0.0.1 keeps the backend local (the container image sets 0.0.0.0). Any address other than a
# loopback one (127.x.x.x, ::1, localhost) needs OWNER_TOKEN and SESSION_SECRET, or the backend refuses to start.
HOST=127.0.0.1
# SQLite database file (dialog, alerts, telemetry, settings, usage).
DATABASE_PATH=./data/copilot.sqlite

# Claude API key created in the Claude Console (platform.claude.com) organisation linked to your subscription;
# never your subscription login. Empty = mock mode under CLAUDE_MODE=auto. Never commit or share it.
ANTHROPIC_API_KEY=
# auto = live when a key is set, otherwise mock; live = require a key (startup error without one); mock = never call Claude.
CLAUDE_MODE=auto
# Model for written answers.
CLAUDE_MODEL=claude-opus-5-5
# Model for spoken answers; empty = same as CLAUDE_MODEL.
CLAUDE_MODEL_VOICE=
# Effort for written answers: low, medium or high.
CLAUDE_EFFORT=medium
# Effort for spoken answers: low, medium or high.
CLAUDE_EFFORT_VOICE=low
# Upper bound on output tokens per answer (1024 to 128000). A question in flight holds this many output tokens'
# price against the budgets until it ends.
CLAUDE_MAX_TOKENS=16000
# Timeout for one Claude request, in milliseconds.
CLAUDE_TIMEOUT_MS=60000

# Daily spend limit in USD; questions are refused once it is reached.
BUDGET_DAILY_USD=1
# Monthly spend limit in USD; questions are refused once it is reached.
BUDGET_MONTHLY_USD=20
# Maximum number of questions per minute.
RATE_LIMIT_PER_MINUTE=10
# Number of earlier dialog turns sent with each question.
HISTORY_TURNS=4

# Owner access. With OWNER_TOKEN set, every /api route except /api/health and /api/session needs a signed in-browser
# session: the panel asks for this token once («Вхід») and keeps a session cookie for 30 days. At least 24 characters,
# no spaces; make it random (for example `openssl rand -base64 32`). Empty = the API is open, allowed only on a
# loopback HOST. Never commit or share it.
OWNER_TOKEN=
# Signs the session cookie; required (at least 32 characters, no spaces) when OWNER_TOKEN is set. Changing it ends
# every session. Never commit or share it.
SESSION_SECRET=

# Where vehicle data comes from: mock (scripted scenarios) or car (the paired head unit reports through /car/v1; the
# car evaluates the alert rules itself). Set car (with OWNER_TOKEN and SESSION_SECRET) before installing the car app:
# with mock the backend refuses the car's data and questions. The database remembers which source wrote it: starting
# with car on a demo database discards the demo alerts, telemetry and engine state (devices, settings, spend and
# dialog are kept; older dialog is no longer given to Claude); starting with mock on the car's database is refused
# (see the next variable). To run the demo beside real data, give it its own DATABASE_PATH: run it with npm, not in
# the Compose container, where DATABASE_PATH is fixed by docker-compose.yml.
VEHICLE_SOURCE=mock
# 1 = for this one start, allow mock on a database that holds the car's data (deletes its telemetry, clears its alerts).
ALLOW_VEHICLE_SOURCE_RESET=
# Mock scenario at startup.
MOCK_SCENARIO=steady-cruise
# Optional short description of the car given to Claude (no VIN, no personal data; a 17-character VIN-shaped code
# stops the backend at startup).
VEHICLE_LABEL=

# Interval between stored telemetry samples, in milliseconds.
TELEMETRY_SAMPLE_INTERVAL_MS=60000
# Days raw telemetry samples are kept (daily roll-ups are kept longer).
TELEMETRY_RETENTION_DAYS=90

# Origin allowed to call the API from a browser (the Angular dev server).
CORS_ORIGIN=http://localhost:4200
# pino log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
