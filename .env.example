# BMW AI Copilot backend configuration. Copy to `.env` (never committed) and adjust.
# Every variable is optional; the value shown is the default.

# HTTP port the backend listens on.
PORT=3000
# Interface to bind; 127.0.0.1 keeps the backend local (the container image sets 0.0.0.0).
HOST=127.0.0.1
# SQLite database file (dialog, alerts, telemetry, settings, usage).
DATABASE_PATH=./data/copilot.sqlite

# Claude API key from the Console organisation linked to your subscription. Empty = mock mode under CLAUDE_MODE=auto.
ANTHROPIC_API_KEY=
# auto = live when a key is set, otherwise mock; live = require a key (startup error without one); mock = never call Claude.
CLAUDE_MODE=auto
# Model for written answers.
CLAUDE_MODEL=claude-opus-5-5
# Model for spoken answers; empty = same as CLAUDE_MODEL.
CLAUDE_MODEL_VOICE=
# Effort for written answers: low, medium or high.
CLAUDE_EFFORT=medium
# Effort for spoken answers: low, medium or high.
CLAUDE_EFFORT_VOICE=low
# Upper bound on output tokens per answer.
CLAUDE_MAX_TOKENS=16000
# Timeout for one Claude request, in milliseconds.
CLAUDE_TIMEOUT_MS=60000

# Daily spend limit in USD; questions are refused once it is reached.
BUDGET_DAILY_USD=1
# Monthly spend limit in USD; questions are refused once it is reached.
BUDGET_MONTHLY_USD=20
# Maximum number of questions per minute.
RATE_LIMIT_PER_MINUTE=10
# Number of earlier dialog turns sent with each question.
HISTORY_TURNS=4

# Where vehicle data comes from: mock (scripted scenarios) or car (Plan 2).
VEHICLE_SOURCE=mock
# Mock scenario at startup.
MOCK_SCENARIO=steady-cruise
# Optional short description of the car given to Claude (no VIN, no personal data).
VEHICLE_LABEL=

# Interval between stored telemetry samples, in milliseconds.
TELEMETRY_SAMPLE_INTERVAL_MS=60000
# Days raw telemetry samples are kept (daily roll-ups are kept longer).
TELEMETRY_RETENTION_DAYS=90

# Origin allowed to call the API from a browser (the Angular dev server).
CORS_ORIGIN=http://localhost:4200
# pino log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
