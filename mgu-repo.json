{
  "schema": 1,
  "apps": {
    "path": "car/apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": ["ID7"],
    "requires": { "mgu-render": "0.6.11" },
    "build": {
      "python": "car/kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "car/oap-sdk",
      "output": "car/dist/{id}@{version}.tgz"
    }
  }
}
