# Settings for car/scripts/publish-car.mjs. Copy this file to .env.car (git-ignored) and fill it in there.
# Never commit .env.car: the backend address must not reach this public repository.
# See docs/CAR_INSTALL.md.

# A separate, private git checkout you control: the MGU Store source the car installs from.
# It must exist and must not be inside this repository.
CAR_DEPLOY_DIR=/absolute/path/to/your-private-deploy-checkout

# Your backend's public https:// address, as your phone opens it (no trailing slash).
# The car app talks to it, and the pairing QR code on the car screen points to its /pair page.
CAR_BACKEND_URL=https://example.invalid
