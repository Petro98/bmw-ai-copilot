{
  "name": "bmw-ai-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only, Ukrainian-speaking AI assistant for a BMW: head-unit app, backend and phone panel.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/backend",
    "car"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "node8": "npm run build -w @copilot/vehicle-core -w @copilot/event-engine && scripts/run-node8.sh scripts/node8-smoke.js",
    "build:car": "node car/scripts/build-car.mjs",
    "check:car": "npm run build:car && scripts/run-node8.sh --check car/apps/p98_copilot/main.js && car/scripts/preview-car.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
